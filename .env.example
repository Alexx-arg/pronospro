# =============================================================================
# Football Prediction App - .env.example
# Copiar a .env y completar. NUNCA incluir .env en el cliente Flutter.
# El frontend solo recibe BACKEND_BASE_URL y ENV (ver frontend/.env).
#
# Este archivo refleja 1:1 los aliases de backend/app/config.py.
# Toda variable aquí listada (sin el prefijo "# (futuro:)") tiene un
# Field(alias=...) correspondiente en config.py.
# =============================================================================

# ---------- App ----------
ENV=development
LOG_LEVEL=INFO
BACKEND_API_PREFIX=/api/v1
ADMIN_API_KEY=change-me-internal-admin-key
# (futuro: no implementado en config.py aún — reservado para CORS)
# BACKEND_CORS_ORIGINS=http://localhost:8080

# ---------- PostgreSQL ----------
POSTGRES_USER=football
POSTGRES_PASSWORD=changeme
POSTGRES_DB=football
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Si DATABASE_URL está seteada, toma precedencia sobre los campos sueltos.
DATABASE_URL=postgresql+asyncpg://football:changeme@postgres:5432/football

# ---------- DB connection tuning ----------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---------- App role (matches init.sql / migration 0001 grants) ----------
DB_APP_ROLE=app_user
DB_APP_ROLE_PASSWORD=changeme

# ---------- API-Football provider ----------
DATA_PROVIDER=api_football
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_RATE_LIMIT_PER_MIN=30
API_FOOTBALL_RATE_LIMIT_PER_DAY=300
API_FOOTBALL_TIMEOUT_SECONDS=30
API_FOOTBALL_MAX_RETRIES=3
API_FOOTBALL_USER_AGENT=football-prediction-app/0.1
# Tamaño del pool HTTP (httpx).
API_FOOTBALL_MAX_CONNECTIONS=20
API_FOOTBALL_MAX_KEEPALIVE_CONNECTIONS=10

# ---------- NVIDIA NIM Explanation Service ----------
# Obtén tu API key en https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ---------- Scheduling ----------
# Master switch. Cuando false, el scheduler no arranca (los jobs siguen
# siendo invocables manualmente vía admin endpoint / CLI con force=True).
SCHEDULER_ENABLED=false

# Upcoming fixtures: flag + ventana de días mirada hacia adelante + intervalo.
SYNC_UPCOMING_ENABLED=true
SYNC_UPCOMING_DAYS=7
SYNC_UPCOMING_INTERVAL_MINUTES=60

# Finished fixtures: flag + ventana de horas mirada hacia atrás + intervalo.
SYNC_FINISHED_ENABLED=true
SYNC_FINISHED_WINDOW_HOURS=6
SYNC_FINISHED_INTERVAL_MINUTES=15

# Teams: flag + intervalo (roster raramente cambia, cadencia baja).
SYNC_TEAMS_ENABLED=true
SYNC_TEAMS_INTERVAL_MINUTES=720

# Team statistics: snapshot diario por (team, league, season, as_of_date).
SYNC_TEAM_STATISTICS_ENABLED=true
SYNC_TEAM_STATISTICS_INTERVAL_MINUTES=360

# Player statistics: el job más costoso; respeta el rate limit del provider.
SYNC_PLAYER_STATISTICS_ENABLED=true
SYNC_PLAYER_STATISTICS_INTERVAL_MINUTES=360

# Injuries: enable + cadencia.
SYNC_INJURIES_ENABLED=true
SYNC_INJURIES_INTERVAL_MINUTES=180

# Lineups: enable + cadencia (más frecuente, sensible al kickoff).
SYNC_LINEUPS_ENABLED=true
SYNC_LINEUPS_INTERVAL_MINUTES=120

# (futuro: no implementado en config.py aún — reservado para evaluación
#  de outcomes y stats agregadas; ver docs/ARCHITECTURE.md)
# SCHEDULER_STATS_INTERVAL_MINUTES=360
# (futuro: no implementado en config.py aún — reservado para el job de
#  evaluation del motor de predicción, Fase 4+)
# SCHEDULER_EVALUATE_INTERVAL_MINUTES=30

# ---------- Prediction policy ----------
MIN_HOURS_BEFORE_KICKOFF_FOR_PREDICTION=1
CONFIDENCE_BUCKETS=0.0,0.3,0.5,0.7,0.85,1.0

# ---------- Prediction Engine (Fase 5) ----------
# PredictionSettings vive en app/prediction/config.py (pydantic-settings,
# prefijo PREDICTION_). Sprint 5.0 fundacional — sin modelos todavía.
PREDICTION_DATASET_VERSION=v001
PREDICTION_WALK_FORWARD_MIN_TRAIN_SIZE=200
PREDICTION_WALK_FORWARD_VAL_RATIO=0.15
PREDICTION_WALK_FORWARD_TEST_SIZE=50
PREDICTION_WALK_FORWARD_GAP_DAYS=1
PREDICTION_WALK_FORWARD_MODE=expanding
PREDICTION_CALIBRATION_BINS=10
PREDICTION_CONFIDENCE_BUCKETS=0.4,0.5,0.6,0.7,0.8,0.9,1.0
PREDICTION_RANDOM_SEED=42
PREDICTION_MAX_GOALS=10
PREDICTION_NAN_POLICY=drop_row

# ---------- Ligas y temporada objetivo ----------
# IDs separados por coma. 39=Premier League, 140=La Liga, 61=Serie A,
# 135=Bundesliga, 78=Ligue 1.
CURRENT_LEAGUES=39,140,61,135,78
# Año de inicio de la "temporada actual" (2024 = temporada 2024/2025 en
# ligas europeas). El provider espera el año de inicio.
CURRENT_SEASON_YEAR=2024

# ---------- Frontend (leido por Flutter .env, NO COMMITAR .env real) ----------
# Estos viven en frontend/.env si la app lo necesita:
# BACKEND_BASE_URL=http://10.0.2.2:8000

# ---------- Deploy en Render (opcional — solo si desplegás en la nube) ----------
# MODEL_PATH=/app/data/models/final/lightgbm_production.joblib   # ruta interna
# CORS_ORIGINS=*                                                  # o "https://tu-app.onrender.com"
# API_SECRET_KEY=your_api_key_here
# NVIDIA_API_KEY=your_nvidia_key
# NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct